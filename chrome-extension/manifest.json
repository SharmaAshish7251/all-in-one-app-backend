{
  "manifest_version": 3,
  "name": "AIO Downloader — TeraBox Token Sync",
  "version": "1.0.0",
  "description": "Reads the HttpOnly ndus cookie from terabox.com and syncs it to your AIO Downloader backend.",
  "permissions": ["cookies", "activeTab"],
  "host_permissions": [
    "https://www.terabox.com/*",
    "https://terabox.com/*",
    "https://1024terabox.com/*",
    "https://terabox.app/*",
    "http://localhost:4000/*",
    "http://localhost:4001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
