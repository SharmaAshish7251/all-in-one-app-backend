# Server Port
PORT=4000

# Base URL (change to your deployed URL in production, e.g. https://my-backend.onrender.com)
BASE_URL=http://localhost:4000

# TeraBox Session Cookie
# How to get it:
# 1. Log into https://www.terabox.com in your web browser.
# 2. Press F12 -> Application / Storage -> Cookies.
# 3. Copy the value of 'ndus'.
# Format: lang=en; ndus=YOUR_NDUS_TOKEN_HERE
TERABOX_COOKIE=

# Optional Netscape-format YouTube cookies file for videos requiring sign-in.
# On Render, add the cookie file as a Secret File and set this to its path,
# for example: /etc/secrets/youtube-cookies.txt
YOUTUBE_COOKIES_FILE=

# Optional Netscape-format Instagram cookies file for rate-limited public posts.
# On Render, add as a Secret File and set this to its mounted path.
INSTAGRAM_COOKIES_FILE=
